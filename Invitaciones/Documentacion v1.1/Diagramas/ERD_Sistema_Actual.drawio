        <mxCell id="n_verificacionEmail" value="&lt;b&gt;VerificacionEmail&lt;/b&gt; (verificacion_email)&lt;br&gt;──────────────&lt;br&gt;PK id: int&lt;br&gt;FK usuario_id: int&lt;br&gt;codigo: varchar(6)&lt;br&gt;expires_at: timestamp&lt;br&gt;usado: boolean = false&lt;br&gt;created_at: timestamp" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;" vertex="1" parent="1">
