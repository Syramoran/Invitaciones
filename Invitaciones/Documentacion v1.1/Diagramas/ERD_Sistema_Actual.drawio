        <mxCell id="n_notificacion" value="&lt;b&gt;Notificacion&lt;/b&gt; (notificacion)&lt;br&gt;──────────────&lt;br&gt;PK id: int&lt;br&gt;tipo: varchar(30) enum&lt;br&gt;destinatario_email: varchar(255)&lt;br&gt;asunto: varchar(255)&lt;br&gt;mensaje: text&lt;br&gt;enviada: boolean = false&lt;br&gt;fecha_envio: timestamp (null)&lt;br&gt;created_at: timestamp&lt;br&gt;— standalone, sin FK —" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1">
