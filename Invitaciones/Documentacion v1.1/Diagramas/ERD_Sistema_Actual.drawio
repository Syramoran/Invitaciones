        <mxCell id="n_logEliminacion" value="&lt;b&gt;LogEliminacion&lt;/b&gt; (log_eliminacion)&lt;br&gt;──────────────&lt;br&gt;PK id: int&lt;br&gt;invitacion_id_ref: uuid (ref. blanda, sin FK)&lt;br&gt;fecha_eliminacion: timestamp&lt;br&gt;fotos_eliminadas: int = 0&lt;br&gt;detalles: text (null)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1">
