        <mxCell id="n_loginAttempt" value="&lt;b&gt;LoginAttempt&lt;/b&gt; (login_attempt)&lt;br&gt;──────────────&lt;br&gt;PK id: int&lt;br&gt;ip: varchar(45) UQ&lt;br&gt;attempt_count: int = 1&lt;br&gt;locked_until: timestamp (null)&lt;br&gt;created_at: timestamp&lt;br&gt;updated_at: timestamp&lt;br&gt;— standalone, sin FK —" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;" vertex="1" parent="1">
